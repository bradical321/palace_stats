<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Runs the collector hourly, 10am through midnight Mac local (Mountain) time = noon through 2am Eastern.
     If the Mac was asleep at a run time, launchd runs it once on wake.
     caffeinate -i keeps the Mac awake until the run finishes. Wake times live in schedule_wakes.sh. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.palace.collection</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/caffeinate</string>
		<string>-i</string>
		<string>/bin/bash</string>
		<string>/Users/bradreaume/Palace_Stats/streamlit_app/run_collection.sh</string>
	</array>
	<key>StandardErrorPath</key>
	<string>/Users/bradreaume/Palace_Stats/streamlit_app/collection_cron.log</string>
	<key>StandardOutPath</key>
	<string>/Users/bradreaume/Palace_Stats/streamlit_app/collection_cron.log</string>
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Hour</key>
			<integer>10</integer>
			<key>Minute</key>
			<integer>0</integer>
		</dict>
